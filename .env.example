# Set these in Vercel (or your chosen server host). Never expose the service role key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API. Leave blank while setting up the database; bookings will still work.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
BELLE_OWNER_WHATSAPP=27822828139
