# Set these in Vercel (or your chosen server host). Never expose the service role key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API. Leave blank while waiting for approval; bookings will still work.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
BELLE_OWNER_WHATSAPP=27730806573

# Optional email notifications via Resend.
RESEND_API_KEY=your-resend-api-key
BELLE_OWNER_EMAIL=lindokuhle.moyakhe@gmail.com

# Optional SMS notifications via Twilio.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=your-twilio-phone-number
BELLE_OWNER_SMS=27730806573
